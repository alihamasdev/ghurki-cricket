{
	"name": "server",
	"type": "module",
	"main": "src/index.ts",
	"scripts": {
		"build": "tsdown",
		"check-types": "tsc -b",
		"compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
		"dev": "bun run --hot src/index.ts",
		"start": "bun run dist/index.mjs"
	},
	"dependencies": {
		"@ghurki-cricket/api": "workspace:*",
		"@ghurki-cricket/db": "workspace:*",
		"@ghurki-cricket/env": "workspace:*",
		"@trpc/server": "catalog:",
		"cors": "^2.8.6",
		"dotenv": "catalog:",
		"express": "^5.3.0",
		"helmet": "^8.3.0",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@ghurki-cricket/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/cors": "^2.8.19",
		"@types/express": "catalog:",
		"tsdown": "^0.23.4",
		"typescript": "catalog:"
	},
	"trustedDependencies": [
		"supabase"
	]
}
