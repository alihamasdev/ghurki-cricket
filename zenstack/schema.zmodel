datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum PlayerGroup {
  core
  family
  friends
}

model Teams {
  name      String    @id
  slug      String
  avatar    String?
  dateWins  Dates[]
  matchWins Matches[]
  innings   Innings[]

  @@map("teams")
}

model Players {
  name           String      @id
  role           String
  group          PlayerGroup
  avatar         String?
  potm           Matches[]
  batting        Batters[]
  bowling        Bowlers[]
  fielding       Fielders[]
  battingRecords Records[]   @relation("BattingRecord")
  bowlingRecords Records[]   @relation("BowlingRecord")

  @@index([role])
  @@map("players")
}

model Rivalries {
  title     String    @id
  startedAt DateTime  @db.Date
  endedAt   DateTime? @db.Date
  dates     Dates[]
  records   Records[]

  @@map("rivalries")
}

model Dates {
  date      DateTime   @id @db.Date
  title     String
  rivalryId String
  rivalry   Rivalries  @relation(fields: [rivalryId], references: [title])
  winnerId  String?
  winner    Teams?     @relation(fields: [winnerId], references: [name])
  matches   Matches[]
  innings   Innings[]
  batting   Batters[]
  bowling   Bowlers[]
  fielding  Fielders[]

  @@index([rivalryId])
  @@map("dates")
}

model Matches {
  id       Int       @id @default(autoincrement())
  title    String
  overs    Int
  winBy    String
  videoUrl String?
  winnerId String
  winner   Teams     @relation(fields: [winnerId], references: [name])
  potmId   String?
  potm     Players?  @relation(fields: [potmId], references: [name])
  dateId   DateTime  @db.Date
  date     Dates     @relation(fields: [dateId], references: [date])
  innings  Innings[]

  @@index([potmId])
  @@index([winnerId])
  @@map("matches")
}

model Innings {
  id      Int      @id @default(autoincrement())
  runs    Int      @default(0)
  balls   Int      @default(0)
  wickets Int      @default(0)
  allOuts Int      @default(0)
  teamId  String
  team    Teams    @relation(fields: [teamId], references: [name])
  matchId Int
  match   Matches  @relation(fields: [matchId], references: [id])
  dateId  DateTime @db.Date
  date    Dates    @relation(fields: [dateId], references: [date])

  @@index([matchId])
  @@index([teamId])
  @@map("innings")
}

model Batters {
  dateId       DateTime @db.Date
  date         Dates    @relation(fields: [dateId], references: [date])
  playerId     String
  player       Players  @relation(fields: [playerId], references: [name])
  innings      Int      @default(0)
  runs         Int      @default(0)
  balls        Int      @default(0)
  highestScore Int      @default(0)
  notOuts      Int      @default(0)
  fours        Int      @default(0)
  sixes        Int      @default(0)
  ducks        Int      @default(0)
  thirties     Int      @default(0)
  fifties      Int      @default(0)

  @@id([playerId, dateId])
  @@index([playerId])
  @@map("batting")
}

model Bowlers {
  dateId   DateTime @db.Date
  date     Dates    @relation(fields: [dateId], references: [date])
  playerId String
  player   Players  @relation(fields: [playerId], references: [name])
  innings  Int      @default(0)
  runs     Int      @default(0)
  balls    Int      @default(0)
  wickets  Int      @default(0)
  dots     Int      @default(0)
  wides    Int      @default(0)
  noBalls  Int      @default(0)
  twoFR    Int      @default(0) @map("2fr")
  threeFR  Int      @default(0) @map("3fr")

  @@id([playerId, dateId])
  @@index([playerId])
  @@map("bowling")
}

model Fielders {
  dateId   DateTime @db.Date
  date     Dates    @relation(fields: [dateId], references: [date])
  playerId String
  player   Players  @relation(fields: [playerId], references: [name])
  innings  Int      @default(0)
  catches  Int      @default(0)
  runOuts  Int      @default(0)

  @@id([playerId, dateId])
  @@index([playerId])
  @@map("fielding")
}

model Records {
  runs      Int       @default(0)
  wickets   Int       @default(0)
  fours     Int       @default(0)
  sixes     Int       @default(0)
  dots      Int       @default(0)
  batterId  String
  batter    Players   @relation("BattingRecord", fields: [batterId], references: [name])
  bowlerId  String
  bowler    Players   @relation("BowlingRecord", fields: [bowlerId], references: [name])
  rivalryId String
  rivalry   Rivalries @relation(fields: [rivalryId], references: [title])

  @@id([batterId, bowlerId, rivalryId])
  @@index([batterId, bowlerId])
  @@map("records")
}

model Expenses {
  date      DateTime @id @db.Date
  ground    String   @default("Mithu Indoor")
  groundFee Int      @default(0)
  gearCost  Int      @default(0)

  @@index([ground])
  @@map("expenses")
}
