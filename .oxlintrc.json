{
	"$schema": "./node_modules/oxlint/configuration_schema.json",
	"plugins": ["typescript", "unicorn", "oxc", "typescript", "react"],
	"jsPlugins": ["@shadcn/lint"],
	"categories": {
		"correctness": "warn"
	},
	"rules": {
		"shadcn/no-restyle": ["error", { "allow": ["layout"] }]
	},
	"env": {
		"builtin": true
	}
}
