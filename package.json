{
	"name": "ghurki-cricket",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^17.4.2",
			"zod": "^4.4.3",
			"@types/bun": "^1.4.0",
			"@types/node": "^26.2.0",
			"@trpc/server": "^11.18.0",
			"@types/express": "^5.0.6",
			"lucide-react": "^1.27.0",
			"@trpc/tanstack-react-query": "^11.18.0",
			"@trpc/client": "^11.18.0",
			"@tanstack/react-query": "^5.101.4",
			"@types/react-dom": "^19.2.3",
			"tailwindcss": "^4.3.3"
		}
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "oxlint && oxfmt --write",
		"check-types": "turbo run check-types",
		"db:generate": "turbo run db:generate -F @ghurki-cricket/db --",
		"db:migrate": "turbo run db:migrate -F @ghurki-cricket/db --",
		"db:push": "turbo run db:push -F @ghurki-cricket/db --",
		"db:studio": "turbo run db:studio -F @ghurki-cricket/db --",
		"deploy": "vercel deploy",
		"deploy:check": "vercel deploy --dry",
		"deploy:prod": "vercel deploy --prod",
		"deploy:setup": "vercel link",
		"dev": "turbo run dev",
		"dev:native": "turbo run dev -F native --",
		"dev:server": "turbo run dev -F server --",
		"dev:vercel": "vercel dev -L",
		"dev:web": "turbo run dev -F web --",
		"env:preview": "tsx scripts/sync-vercel-env.ts preview",
		"env:production": "tsx scripts/sync-vercel-env.ts production"
	},
	"dependencies": {
		"@ghurki-cricket/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@ghurki-cricket/config": "workspace:*",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"oxfmt": "^0.65.0",
		"oxlint": "^1.80.0",
		"tsx": "^4.23.1",
		"turbo": "^2.10.12",
		"typescript": "^6.0.3",
		"vercel": "^58.1.0"
	},
	"packageManager": "bun@1.3.14"
}
