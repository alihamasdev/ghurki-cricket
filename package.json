{
	"name": "ghurki-cricket",
	"private": true,
	"workspaces": {
		"packages": [
			"apps/*",
			"packages/*"
		],
		"catalog": {
			"dotenv": "^18.0.9",
			"zod": "^4.6.7",
			"@types/bun": "^1.4.4",
			"@types/node": "^26.6.6",
			"@trpc/server": "^11.24.0",
			"@types/express": "^5.0.6",
			"@trpc/tanstack-react-query": "^11.24.0",
			"@trpc/client": "^11.24.0",
			"@tanstack/react-query": "^5.106.1",
			"@tanstack/react-table": "^9.3.1",
			"tailwindcss": "^4.3.4",
			"typescript": "^7.0.2"
		}
	},
	"type": "module",
	"scripts": {
		"build": "turbo run build",
		"check": "oxlint --fix && oxfmt --write",
		"check-types": "turbo run check-types",
		"db:generate": "turbo run db:generate -F @ghurki-cricket/db --",
		"db:migrate": "turbo run db:migrate -F @ghurki-cricket/db --",
		"db:push": "turbo run db:push -F @ghurki-cricket/db --",
		"db:studio": "turbo run db:studio -F @ghurki-cricket/db --",
		"deploy:prev": "vercel",
		"deploy:prod": "vercel --prod",
		"dev": "turbo run dev",
		"dev:native": "turbo run dev -F native --",
		"dev:server": "turbo run dev -F server --",
		"dev:vercel": "vercel dev -L",
		"dev:web": "turbo run dev -F web --",
		"env:prev": "tsx scripts/sync-vercel-env.ts preview",
		"env:prod": "tsx scripts/sync-vercel-env.ts production",
		"upload-player-images": "bun scripts/upload-player-images.ts"
	},
	"dependencies": {
		"@ghurki-cricket/env": "workspace:*",
		"dotenv": "catalog:",
		"zod": "catalog:"
	},
	"devDependencies": {
		"@ghurki-cricket/config": "workspace:*",
		"@shadcn/lint": "^0.2.5",
		"@supabase/supabase-js": "^2.119.0",
		"@types/bun": "catalog:",
		"@types/node": "catalog:",
		"oxfmt": "^0.77.0",
		"oxlint": "^1.92.0",
		"sharp": "^0.35.5",
		"tsx": "^4.23.15",
		"turbo": "^2.11.10",
		"typescript": "catalog:",
		"vercel": "^65.12.1"
	},
	"packageManager": "bun@1.3.14"
}
